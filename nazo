<script>
  function switchChannel(roomId, channelName, btnElement) {
    const allAreas = document.querySelectorAll('.chat-area');
    allAreas.forEach(area => area.classList.remove('active'));
    document.getElementById(roomId).classList.add('active');

    const allBtns = document.querySelectorAll('.channel-btn');
    allBtns.forEach(btn => btn.classList.remove('active'));
    btnElement.classList.add('active');

    // 「🔒謎実装」のような文字列から鍵マークを除去してヘッダーに表示する場合の処理
    const cleanChannelName = channelName.replace('🔒', '');
    
    // もし鍵付きならヘッダーのハッシュタグ部分を非表示にして鍵にする演出
    const hashtagEl = document.getElementById('header-hashtag');
    if (channelName.includes('🔒')) {
      hashtagEl.textContent = '🔒';
    } else {
      hashtagEl.textContent = '#';
    }

    document.getElementById('header-title').textContent = cleanChannelName;
  }
</script>

