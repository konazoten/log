<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>小謎展覧会 制作チャット</title>
<style>
  /* 全体の設定 */
  body {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    background-color: #1e1f22;
    margin: 0;
    padding: 20px;
    display: flex;
    justify-content: center;
    color: #dbdee1;
  }
  
  /* Discordアプリの枠組み */
  .discord-app {
    width: 100%;
    max-width: 900px;
    height: 700px;
    display: flex;
    background-color: #313338;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.6);
  }

  /* 左側のサイドバー */
  .sidebar {
    width: 240px;
    background-color: #2b2d31;
    display: flex;
    flex-direction: column;
    padding: 10px;
  }
  
  .sidebar-title {
    font-size: 12px;
    font-weight: bold;
    color: #949ba4;
    text-transform: uppercase;
    margin: 10px 0 5px 8px;
  }

  .channel-btn {
    display: flex;
    align-items: center;
    padding: 8px;
    margin-bottom: 2px;
    border: none;
    background: transparent;
    color: #949ba4;
    font-size: 16px;
    font-weight: 500;
    cursor: pointer;
    border-radius: 4px;
    text-align: left;
  }
  
  .channel-btn:hover {
    background-color: #35373c;
    color: #dbdee1;
  }

  .channel-btn.active {
    background-color: #404249;
    color: #fff;
  }

  .hashtag {
    font-size: 18px;
    color: #80848e;
    margin-right: 6px;
  }

  /* 右側のチャットエリア */
  .chat-container {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .chat-header {
    height: 48px;
    border-bottom: 1px solid #1f2023;
    display: flex;
    align-items: center;
    padding: 0 16px;
    font-weight: bold;
    font-size: 16px;
    color: #fff;
    box-shadow: 0 1px 2px rgba(0,0,0,0.2);
  }

  .chat-area {
    display: none;
    flex: 1;
    padding: 16px 0;
    overflow-y: auto;
  }
  .chat-area.active {
    display: block;
  }

  /* 日付の区切り線 */
  .date-divider {
    display: flex;
    align-items: center;
    margin: 24px 16px 8px 16px;
  }
  
  .date-divider::before,
  .date-divider::after {
    content: "";
    flex: 1;
    height: 1px;
    background-color: #3f4147;
  }

  .date-text {
    padding: 0 10px;
    font-size: 12px;
    font-weight: bold;
    color: #949ba4;
  }

  /* システムメッセージ */
  .system-message {
    margin: 16px 16px;
    padding: 12px;
    background-color: #2b2d31;
    border-left: 4px solid #ed4245;
    color: #949ba4;
    font-size: 14px;
    font-style: italic;
    border-radius: 0 4px 4px 0;
    text-align: center;
  }

  /* 文字化け（グリッチ）の演出スタイル */
  .glitch-text {
    display: inline-block;
    color: #ed4245;
    background-color: rgba(237, 66, 69, 0.1);
    padding: 0 4px;
    border-radius: 3px;
    font-family: monospace;
    letter-spacing: 2px;
    text-shadow: 1px 0 2px rgba(255,0,0,0.8);
    animation: glitch-anim 0.5s infinite;
  }

  @keyframes glitch-anim {
    0% { opacity: 1; }
    50% { opacity: 0.7; }
    100% { opacity: 1; }
  }

  /* メッセージのスタイル */
  .message {
    display: flex;
    padding: 4px 16px;
    margin-top: 12px;
  }
  
  .message:hover {
    background-color: #2e3035;
  }
  
  .message.consecutive {
    margin-top: 0;
    padding-top: 2px;
    padding-bottom: 2px;
  }
  .message.consecutive .avatar {
    opacity: 0;
    pointer-events: none;
  }
  .message.consecutive .message-header {
    display: none;
  }

  /* アバターアイコンの色設定 */
  .avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    margin-right: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    flex-shrink: 0;
  }
  .av-shoko { background-color: #faa61a; }
  .av-shishito { background-color: #5865F2; }
  .av-kobushi { background-color: #57F287; }
  .av-akiakane { background-color: #EB459E; }
  .av-higure { background-color: #95a5a6; }

  .message-content {
    flex: 1;
    width: 100%;
  }

  .message-header {
    display: flex;
    align-items: baseline;
    margin-bottom: 4px;
  }

  .username {
    font-size: 16px;
    font-weight: 500;
    color: #f2f3f5;
    margin-right: 8px;
  }
  
  .name-shoko { color: #faa61a; }
  .name-shishito { color: #5865F2; }
  .name-kobushi { color: #57F287; }
  .name-akiakane { color: #EB459E; }

  .timestamp {
    font-size: 12px;
    color: #949ba4;
  }

  .message-text {
    font-size: 15px;
    line-height: 1.4;
    color: #dbdee1;
  }

  /* iframe（伝助）の枠設定 */
  .embedded-site {
    width: 100%;
    height: 400px;
    border: none;
    border-radius: 8px;
    margin-top: 10px;
    background-color: #fff;
  }

  /* ★★★ アクセス拒否（権限なし）画面のスタイル ★★★ */
  .restricted-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 80%;
    text-align: center;
    color: #949ba4;
    padding: 20px;
  }
  .lock-icon-large {
    font-size: 64px;
    margin-bottom: 20px;
    filter: grayscale(100%) opacity(0.5); /* 色をなくして冷たい印象に */
  }
  .restricted-title {
    font-size: 20px;
    font-weight: bold;
    color: #f2f3f5;
    margin-bottom: 10px;
  }
  .restricted-desc {
    font-size: 14px;
    line-height: 1.6;
  }
</style>
</head>
